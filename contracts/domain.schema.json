{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "数字草书限量履约领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SERIAL_HELD",
        "PAYMENT_CONFIRMED",
        "REGISTRATION_ACCEPTED",
        "PHYSICAL_DISPATCHED",
        "ORDER_REMEDIED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "edition",
        "serial_reservation",
        "purchase_order",
        "fulfillment_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
